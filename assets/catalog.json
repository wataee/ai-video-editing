{
  "name": "Ultimate Viral Video Editing Asset Library",
  "version": "2.0.0",
  "standard": "Joseph / Ultimate Editors & Mahabur Rahman Specification",
  "root": "assets",
  "sfx": {
    "whooshes": {
      "role": "Movement (slides, pans, zooms, camera moves, scene transitions)",
      "target_level_db": -12.0,
      "max_level_db": -10.0,
      "alignment_rule": "Peak of whoosh locked to the fastest frame of movement",
      "categories": {
        "deep_voice": {
          "description": "Textured sci-fi low sweep, primary default for standard animations and zooms",
          "files": [
            "assets/sfx/whooshes/deep_voice_whoosh_01.wav",
            "assets/sfx/whooshes/deep_voice_whoosh_02.wav",
            "assets/sfx/whooshes/deep_voice_whoosh_03.wav"
          ]
        },
        "hollow": {
          "description": "Resonant texture for standard text slides and camera pans",
          "files": [
            "assets/sfx/whooshes/hollow_whoosh_01.wav",
            "assets/sfx/whooshes/hollow_whoosh_02.wav"
          ]
        },
        "futuristic": {
          "description": "High-tech rapid motion swoosh",
          "files": [
            "assets/sfx/whooshes/whoosh_clean_fast.wav"
          ]
        },
        "organic_wind": {
          "description": "Soft gentle air for slow camera drifts and subtle reveals",
          "files": [
            "assets/sfx/whooshes/whoosh_subtle_air.wav"
          ]
        },
        "transitions": {
          "description": "Scene-to-scene transition swooshes with sci-fi edge",
          "files": [
            "assets/sfx/whooshes/synthetic_transition_whoosh.wav",
            "assets/sfx/whooshes/transition_spacey_whoosh.wav"
          ]
        }
      }
    },
    "textures": {
      "role": "Events that happen without sliding (pops, clicks, reveals, typewriter, UI)",
      "target_level_db": -6.5,
      "alignment_rule": "Placed exactly on the event frame",
      "categories": {
        "pops": {
          "description": "Clean pop-up for UI elements and graphics",
          "files": [
            "assets/sfx/pops/pop_cartoon_clean.wav",
            "assets/sfx/pops/pop_bubble_high.wav",
            "assets/sfx/pops/glass_pop.wav",
            "assets/sfx/pops/pop_01.wav",
            "assets/sfx/pops/pop_02.wav"
          ]
        },
        "clicks_ui": {
          "description": "Tactile clicks for buttons, toggles and state changes",
          "files": [
            "assets/sfx/clicks/mouse_click_soft.wav",
            "assets/sfx/clicks/mechanical_button.wav",
            "assets/sfx/clicks/switch_01.wav",
            "assets/sfx/clicks/click_01.wav",
            "assets/sfx/clicks/click_02.wav",
            "assets/sfx/clicks/select_01.wav"
          ]
        },
        "gears_typewriter": {
          "description": "Letter-by-letter text write-outs and mechanical sequence pop-ups",
          "files": [
            "assets/sfx/textures/tiny_gearwheel_loop.wav",
            "assets/sfx/textures/complex_mechanism_gizmo.wav",
            "assets/sfx/textures/scratch_01.wav",
            "assets/sfx/textures/scratch_02.wav"
          ]
        },
        "sci_fi_hits": {
          "description": "Impact hits when a brand new UI or object is revealed into scene",
          "files": [
            "assets/sfx/glitches/sci_fi_impact_reveal.wav",
            "assets/sfx/glitches/activate_energy_hit.wav",
            "assets/sfx/glitches/glitch_01.wav",
            "assets/sfx/glitches/glitch_02.wav"
          ]
        },
        "camera_shutter": {
          "description": "Camera click on cuts, screen flashes or picture take",
          "files": [
            "assets/sfx/textures/camera_click_fast.wav"
          ]
        }
      }
    },
    "risers_hits": {
      "role": "Anticipation and release at chapter/scene boundaries",
      "target_level_db": -5.0,
      "alignment_rule": "Riser ends on the transition frame; Hit sits directly underneath it",
      "rules": [
        "First sharp bass riser placed ~5s after hook",
        "Minimum 2 sharp bass + 2 metallic risers across video"
      ],
      "categories": {
        "sharp_bass_risers": {
          "description": "Punchy low-end pitch bend up, Joseph favorite #1",
          "files": [
            "assets/sfx/risers/sharp_bass_riser_01.wav",
            "assets/sfx/risers/sharp_bass_riser_02.wav",
            "assets/sfx/risers/sharp_bass_riser_fast.wav"
          ]
        },
        "metallic_risers": {
          "description": "Shimmering metallic tension build, Joseph favorite #2",
          "files": [
            "assets/sfx/risers/metallic_riser_01.wav",
            "assets/sfx/risers/metallic_riser_02.wav"
          ]
        },
        "suck_back_risers": {
          "description": "Slow steep crescendo into sudden drop (very loud or very low)",
          "files": [
            "assets/sfx/risers/suck_back_riser_01.wav",
            "assets/sfx/risers/suck_back_riser_fast.wav",
            "assets/sfx/risers/riser_subtle.wav"
          ]
        },
        "impact_hits": {
          "description": "Cinematic booms placed under risers to resolve transitions",
          "files": [
            "assets/sfx/hits/cinematic_boom_01.wav",
            "assets/sfx/hits/bass_drop_hit_01.wav",
            "assets/sfx/hits/sub_bass_thud.wav"
          ]
        }
      }
    }
  },
  "music": {
    "role": "Background mood and energy bedrock (-18 dB to -24 dB LUFS beneath speech)",
    "tracks": [
      {
        "id": "tech_minimal",
        "title": "Poilo",
        "archetype": "tech/minimal",
        "path": "assets/music/tech_minimal.mp3",
        "license": "CC0 1.0 Universal"
      },
      {
        "id": "dark_cinematic",
        "title": "Evil Awaits",
        "archetype": "dark cinematic",
        "path": "assets/music/dark_cinematic.mp3",
        "license": "CC0 1.0 Universal"
      },
      {
        "id": "energetic_beat",
        "title": "OMW to beat the big bad",
        "archetype": "energetic beat",
        "path": "assets/music/energetic_beat.mp3",
        "license": "CC0 1.0 Universal"
      },
      {
        "id": "lofi_background",
        "title": "Bartender (lofi compilation)",
        "archetype": "lo-fi background",
        "path": "assets/music/lofi_background.mp3",
        "license": "CC0 1.0 Universal"
      },
      {
        "id": "dark_investigation",
        "title": "Unsolved Investigation",
        "archetype": "dark cinematic",
        "path": "assets/music/dark_investigation.mp3",
        "license": "CC0 1.0 Universal"
      }
    ]
  },
  "fonts": {
    "pairing_rule": "Every title lockup must combine a heavy bold Sans font with an expressive cursive Script font",
    "primary_sans": [
      {
        "name": "Montserrat",
        "postscript": "Montserrat-Black",
        "role": "Primary bold hook/title"
      },
      {
        "name": "Inter",
        "postscript": "Inter-Black",
