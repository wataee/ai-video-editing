      },
      {
        "name": "Oswald",
        "postscript": "Oswald-Bold",
        "role": "Tall condensed punch"
      }
    ],
    "secondary_script": [
      {
        "name": "Caveat",
        "postscript": "Caveat-Regular",
        "style": "Bold",
        "role": "Casual brush handwriting, -9 deg tilt, overlapping"
      }
    ]
  },
  "graphics": {
    "overlays": {
      "film_grain": "assets/overlays/film_grain/film_grain_35mm_loop.mp4",
      "tech_grid": "assets/overlays/grids/tech_grid_1080x1920.svg",
